<html>
    <body>
        <h1>Posts</h1>

        <% if (locals.posts) { %>

            <ul>

                <% posts.forEach((post) => { %>

                    <li>
                        <h2><%= post.title %></h2>

                        <p><%= post.text %></p>
                    </li>

                    <ul>

                        <% post.comments.forEach((comment) => { %>
                            <li>
                                <%= comment.text %>
                            </li>
                        <% }); %>

                    </ul>

                <% }); %>

            </ul>

        <% } %>

        <button onclick="location.href='/posts/create';">Create Post</button>
    </body>
</html>